-- ปุ่มกดสั่งเล่นเพลง
_pb.MouseButton1Click:Connect(function()
    local rawId = _ib.Text:match("%d+")
    if not rawId then return end

    local payload = buildPayload(rawId)
    _reE:FireServer(payload)

    _pb.Text = "PLAYING..."
    task.wait(1)
    _pb.Text = "▶ เล่นเพลง"
end)

