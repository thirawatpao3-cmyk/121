local function simpleUrlEncode(str)
    local hex = "0123456789ABCDEF"
    local result = ""
    for i = 1, #str do
        local b = string.byte(str, i)
        result = result .. "%" .. string.sub(hex, math.floor(b/16)+1, math.floor(b/16)+1) .. string.sub(hex, (b%16)+1, (b%16)+1)
    end
    return result
end

local function buildPayload(rawId)
    return _wrap() .. simpleUrlEncode(rawId) .. " " .. suffixPayload
end

local function tryGetProductInfo(input)
    local num = tonumber(input)
    if not num then return nil, "Invalid ID" end
    local success, info = pcall(function()
        return MarketplaceService:GetProductInfo(num)
    end)
    return success and info or nil
end

local function getRainbowColor(offset)
    local hue = (tick() * 0.8 + offset) % 1
    return Color3.fromHSV(hue, 1, 1)
end

